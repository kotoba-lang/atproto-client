{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
              ;; Advanced from b47b064: that pin predates json's kwargs fix
       ;; (d5137c7), so `(read-str s :key-fn keyword)` -- the clojure.data.json
       ;; call shape this repo was migrated to -- threw ArityException at every
       ;; call site. The fix was on json's main and could not reach here.
       io.github.kotoba-lang/json {:git/sha "15fd195ac41e6268e2005ccbf6cb9924e81e65e2"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.babashka/http-client {:mvn/version "0.4.22"}
                      cheshire/cheshire {:mvn/version "5.13.0"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
